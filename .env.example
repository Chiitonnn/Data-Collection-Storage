# Everything is optional: the project works out of the box with open data.

# --- Tempo source ---------------------------------------------------------
# auto   = official RTE API if credentials below are set, public api-couleur-tempo.fr otherwise
# rte    = RTE API only (fails if it is down)
# public = api-couleur-tempo.fr only
TEMPO_SOURCE=auto
# Create an app on https://data.rte-france.com and subscribe it to "Tempo Like Supply Contract"
RTE_CLIENT_ID=
RTE_CLIENT_SECRET=

# --- Storage ----------------------------------------------------------------
# Default: SQLite file in data/tempo.db. For PostgreSQL (pip install psycopg[binary]):
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/tempo
DATA_DIR=./data

# --- Pipeline ---------------------------------------------------------------
SCHEDULE_TIMES=07:00,11:30,18:00
RETRAIN_EVERY_DAYS=7
HORIZONS=1,2,3,4,5
LOG_LEVEL=INFO
# DISABLE_PREFECT=1   # run the pipeline as plain Python (no Prefect)
